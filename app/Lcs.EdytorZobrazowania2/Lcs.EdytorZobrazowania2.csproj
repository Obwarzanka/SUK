<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Lcs.EdytorZobrazowania2</RootNamespace>
    <AssemblyName>EdytorZobrazowania2</AssemblyName>
    <AssemblyTitle>Edytor zobrazowania LCS (nowy)</AssemblyTitle>
    <Product>Edytor zobrazowania LCS (nowy)</Product>
    <Version>0.1.0</Version>
    <StartupObject>Lcs.EdytorZobrazowania2.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- dane testowe wspólne ze starym edytorem: mijanka z testu edytora UT i obraz w wersji 1 -->
    <None Update="Testy\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lcs.Model\Lcs.Model.csproj" />
    <!-- E5: podgląd „jak na pulpicie” – rdzeń symulatora (układ, komputer zależności) -->
    <ProjectReference Include="..\Lcs.Core\Lcs.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- kształty symboli pulpitu – ten sam kod co w symulatorze (PanelView), plan § 10 E3 -->
    <Compile Include="..\LcsWidzew\UI\PulpitSymbole.cs" Link="Pulpit\PulpitSymbole.cs" />
    <!-- E5: ten sam kod pulpitu i okno podglądu co w starym edytorze (przed usunięciem starego edytora – E8 – okno podglądu przenieść do wspólnego miejsca) -->
    <Compile Include="..\LcsWidzew\UI\PanelView.cs" Link="Pulpit\PanelView.cs" />
    <None Include="..\LcsWidzew\Data\sygnaly_ie1.json" Link="Data\sygnaly_ie1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
