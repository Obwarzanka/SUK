<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tabor i fizyka jazdy (PLAN_EDYTOR_TABORU.md, wariant B): bez WPF, wspólne dla symulatora (warstwa świata) i edytora taboru. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lcs.Tabor</RootNamespace>
    <AssemblyTitle>Tabor i fizyka jazdy LCS</AssemblyTitle>
    <Product>SUK</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Data\tabor.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
