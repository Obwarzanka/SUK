<Project>
  <!--
    SUK – centralne wersje pakietów NuGet (Central Package Management), S00.03, 18.10.2026.
    Wersje sprawdzone na nuget.org 18.10.2026: najnowsze stabilne w liniach z rozdziału 20, bez prerelease,
    bez znanych podatności w rejestrze NuGet. Opis, licencje i daty: kontrakty/stos/wersje_stosu.json.
    Plik niczego nie dodaje do projektów: pakiet wchodzi dopiero przez <PackageReference Include="..." />
    (bez atrybutu Version) w zadaniu, które go potrzebuje. Zmiana wersji = osobne zadanie z testami
    zgodności; pierwszy projekt z PackageReference włącza packages.lock.json (RestorePackagesWithLockFile).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Wersje z tego pliku obowiązują też zależności przechodnie (np. poprawki bezpieczeństwa niżej). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Logi i diagnostyka (25, S01.01)">
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup Label="Host świata i usługi Windows (S02)">
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Klient sieciowy pulpitu (S04)">
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Konta, OIDC i dane (S03)">
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.7.2" />
    <PackageVersion Include="OpenIddict.Client.SystemIntegration" Version="7.7.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Telemetria OTLP (20, S13)">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
  </ItemGroup>

  <ItemGroup Label="Testy (20) – dotnet test przez Microsoft.Testing.Platform (app/global.json); runner.visualstudio i Test.Sdk tylko dla trybu VSTest w IDE">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>

  <ItemGroup Label="Przypięte zależności przechodnie – poprawki bezpieczeństwa">
    <!-- OpenIddict 7.7.2 wnosi DataProtection/Cryptography.Xml/Pkcs 10.0.11 z ostrzeżeniami NU1902/NU1903 (GHSA-2fmv-rv2c-59x7,
         GHSA-846f-f764-76mx, GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83); 10.0.13 bez znanych podatności. -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Aktualizator – kandydat S12 (bramka 09 nadal obowiązuje)">
    <PackageVersion Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
