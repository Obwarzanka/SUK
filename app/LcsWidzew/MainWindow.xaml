<Window x:Class="LcsWidzew.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LcsWidzew.UI"
        Title="Symulator LCS – komputerowe urządzenia srk (Ie-20)" Width="1600" Height="950"
        WindowState="Maximized" Background="#0d0d0d" Foreground="#d8d8d8" FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#4a4a4a"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#101010"/>
            <Setter Property="RowBackground" Value="#141414"/>
            <Setter Property="AlternatingRowBackground" Value="#191919"/>
            <Setter Property="Foreground" Value="#d0d0d0"/>
            <Setter Property="GridLinesVisibility" Value="Vertical"/>
            <Setter Property="VerticalGridLinesBrush" Value="#2a2a2a"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="RowHeight" Value="18"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="Foreground" Value="#b8b8b8"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0a4a66"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="112"/>
        </Grid.RowDefinitions>

        <!-- pasek górny -->
        <Grid Grid.Row="0" Background="#151515">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="6,4" VerticalAlignment="Center">
                <Button x:Name="BtnLogin" Content="Logowanie" Click="BtnLogin_Click"/>
                <Border x:Name="ChipRole" Background="#2f7d32" Padding="10,2" Margin="6,0" CornerRadius="2"><TextBlock x:Name="TxtRole" Text="Dyżurny" Foreground="White"/></Border>
                <Border Background="#8a7a12" Padding="10,2" CornerRadius="2"><TextBlock x:Name="TxtArea" Text="LCS" Foreground="White"/></Border>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" ToolTip="Wskaźnik kontroli kolorów i „życia” wizualizacji (Ie-20 §7 ust. 3)">
                    <Rectangle Width="11" Height="11" Fill="Red" Margin="1"/><Rectangle Width="11" Height="11" Fill="Lime" Margin="1"/><Rectangle Width="11" Height="11" Fill="Blue" Margin="1"/>
                    <Ellipse x:Name="Life" Width="6" Height="6" Fill="#333" Margin="4,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" ToolTip="Urządzenia zasilające (§14 ust. 3, §23)">
                    <Border x:Name="LampMains" Padding="5,0" Margin="1" BorderBrush="#444" BorderThickness="1"><TextBlock Text="SIEĆ" FontFamily="Consolas"/></Border>
                    <Border x:Name="LampUps" Padding="5,0" Margin="1" BorderBrush="#444" BorderThickness="1"><TextBlock Text="UPS" FontFamily="Consolas"/></Border>
                    <Border x:Name="LampGen" Padding="5,0" Margin="1" BorderBrush="#444" BorderThickness="1"><TextBlock Text="AGR" FontFamily="Consolas"/></Border>
                    <Border x:Name="LampNN" Padding="5,0" Margin="1" BorderBrush="#444" BorderThickness="1"><TextBlock Text="NN" FontFamily="Consolas"/></Border>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="TxtLogged" Text="Zalogowany: –" Foreground="#e8c000" HorizontalAlignment="Center" FontSize="11"/>
                <TextBlock x:Name="TxtNet" Text="" Foreground="#aaa" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,4" VerticalAlignment="Center">
                <TextBlock Text="Tempo:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#888"/>
                <Button Content="⏸" Tag="0" Click="Speed_Click"/>
                <Button Content="1×" Tag="1" Click="Speed_Click"/>
                <Button Content="2×" Tag="2" Click="Speed_Click"/>
                <Button Content="5×" Tag="5" Click="Speed_Click"/>
                <Button Content="10×" Tag="10" Click="Speed_Click"/>
                <Rectangle Width="12"/>
                <Button Content="Dopasuj obraz" Click="FitStation_Click" ToolTip="Kółko myszy – powiększenie, przeciąganie LPM – przesuwanie"/>
                <Button x:Name="BtnOpisy" Content="Opisy" Click="Opisy_Click" ToolTip="Opisy odcinków wyświetlane na żądanie dyżurnego ruchu (Ie-104 § 5 ust. 2); numery torów i nazwy posterunków są widoczne stale"/>
                <Rectangle Width="12"/>
                <Button Content="Plan ruchu" Click="Plan_Click"/>
                <Button Content="Tablica przebiegów" Click="Routes_Click"/>
                <Button Content="Książka E-1758" Click="Book_Click"/>
                <Button Content="EDR" Click="Edr_Click" ToolTip="Elektroniczny dziennik ruchu – dzienniki szlaków posterunku (osobne okno, można przenieść na drugi monitor)"/>
                <Button Content="Instruktor" Click="Instr_Click"/>
                <Button Content="Plan stacji" Click="PlanSt_Click" ToolTip="Plan schematyczny węzła na żywo: pociągi, sygnały na semaforach, zwrotnice (podgląd terenu dla instruktora i do nauki)"/>
                <Button Content="Komputer zależności" Click="Kz_Click" ToolTip="Podgląd stanu wewnętrznego komputera zależności (przebiegi, utwierdzenia, liczniki czasu, blokady, łącze ze stanowiskami)"/>
                <Button Content="Ocena" Click="Score_Click"/>
                <Button x:Name="BtnNet" Content="Stanowiska / sieć" Click="Net_Click" Background="#3a2a5a" ToolTip="Gra wieloosobowa (Radmin VPN), obszary sterowania posterunków, telefon między stanowiskami"/>
                <Button Content="Pomoc (F1)" Click="Help_Click"/>
            </StackPanel>
        </Grid>

        <!-- obraz szczegółowy -->
        <Grid Grid.Row="1">
            <StackPanel x:Name="PageTabs" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" Panel.ZIndex="5"/>
            <ui:PanelView x:Name="Panel"/>
            <TextBlock x:Name="TxtClock" Text="06:00:00" Foreground="#00e000" FontFamily="Consolas" FontSize="30" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,8" IsHitTestVisible="False"/>
            <TextBlock x:Name="TxtPaused" Text="PAUZA" Foreground="#e8c000" FontSize="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,40,0,0" Visibility="Collapsed" IsHitTestVisible="False"/>
            <!-- panel „Polecenia / Historia” wg ISDR – zastępuje menu PPM (ROZWOJ.md § 2a) -->
            <ui:PanelPolecen x:Name="Pol" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,16,0" Panel.ZIndex="6"/>
        </Grid>

        <!-- linia poleceń -->
        <Grid Grid.Row="2" Background="#151515">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Polecenie&gt;" Foreground="#00c0ff" FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,6,0"/>
            <TextBox x:Name="Cmd" Grid.Column="1" Background="Black" Foreground="White" CaretBrush="White" BorderBrush="#555" FontFamily="Consolas" FontSize="14"
                     CharacterCasing="Upper" Margin="0,3" KeyDown="Cmd_KeyDown"/>
            <StackPanel Grid.Column="2" Margin="10,0">
                <TextBlock x:Name="CmdRes" FontFamily="Consolas" Foreground="#3ddc84" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="Hint" Foreground="#8a8a8a" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="#222"/>

        <!-- ZDARZENIA i ALARMY wg ISDR (UI/Dziennik.cs) -->
        <ContentControl x:Name="HostZdarzenia" Grid.Row="4"/>
        <ContentControl x:Name="HostAlarmy" Grid.Row="5"/>
    </Grid>
</Window>
