<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>Symulator LCS Łódź Widzew</AssemblyTitle>
    <Product>Symulator LCS Łódź Widzew</Product>
    <Version>0.2.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lcs.Core\Lcs.Core.csproj" />
    <ProjectReference Include="..\Lcs.WorldHost\Lcs.WorldHost.csproj" />
    <!-- Logi techniczne SUK (S01.01, rozdział 25): MEL + Serilog, ograniczona kolejka, JSONL w %LocalAppData%\SUK\LcsWidzew\Logs -->
    <ProjectReference Include="..\Lcs.Logi\Lcs.Logi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Model\**\*.cs;Sim\**\*.cs" />
    <!-- Ten sam scenariusz regresji w pulpicie i neutralnym runnerze; silnik jest w Lcs.Core. -->
    <Compile Include="Sim\SelfTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\sygnaly_ie1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\station.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
