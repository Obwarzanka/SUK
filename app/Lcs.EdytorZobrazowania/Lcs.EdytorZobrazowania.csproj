<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Lcs.EdytorZobrazowania</RootNamespace>
    <AssemblyName>EdytorZobrazowania</AssemblyName>
    <AssemblyTitle>Edytor zobrazowania LCS</AssemblyTitle>
    <Product>Edytor zobrazowania LCS</Product>
    <Version>0.1.0</Version>
    <StartupObject>Lcs.EdytorZobrazowania.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Testy\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lcs.Model\Lcs.Model.csproj" />
    <!-- Z6: podgląd „jak na pulpicie” – rdzeń symulatora (układ, komputer zależności) i ten sam kod pulpitu (PanelView) co w symulatorze -->
    <ProjectReference Include="..\Lcs.Core\Lcs.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\LcsWidzew\UI\PanelView.cs" Link="Pulpit\PanelView.cs" />
    <None Include="..\LcsWidzew\Data\sygnaly_ie1.json" Link="Data\sygnaly_ie1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
