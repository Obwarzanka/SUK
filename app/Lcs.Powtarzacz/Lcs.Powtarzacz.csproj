<Project Sdk="Microsoft.NET.Sdk">

  <!-- Powtarzacz zdalnej kontroli przejazdów (UZK, Ie-104 § 14, Ie-20 § 21 ust. 8) – osobny program obok pulpitu LCS.
       Stan przejazdów z gry: mod SimRailMost ≥ 0.12, UDP 127.0.0.1:47134 (plan SUK/PLAN_PRZEJAZDY_SSP_UZK.md). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Lcs.Powtarzacz</RootNamespace>
    <AssemblyName>Powtarzacz</AssemblyName>
    <AssemblyTitle>Powtarzacz zdalnej kontroli przejazdów (UZK)</AssemblyTitle>
    <Product>SUK – Powtarzacz UZK</Product>
    <Version>0.1.0</Version>
    <StartupObject>Lcs.Powtarzacz.Program</StartupObject>
  </PropertyGroup>

</Project>
