<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Lcs.Przechylka</RootNamespace>
    <AssemblyName>Przechylka</AssemblyName>
    <AssemblyTitle>Kalkulator przechyłki i krzywej przejściowej</AssemblyTitle>
    <Product>Kalkulator przechyłki LCS</Product>
    <Version>0.1.0</Version>
    <StartupObject>Lcs.Przechylka.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lcs.Model\Lcs.Model.csproj" />
  </ItemGroup>

</Project>
