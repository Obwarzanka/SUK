<?xml version="1.0" encoding="utf-8"?>
<!--
  SUK - zrodla pakietow NuGet (S00.03, 18.10.2026).
  Tylko nuget.org; mapowanie zrodel ogranicza ryzyko podmiany pakietu (dependency confusion).
  Opis i wersje: kontrakty/stos/wersje_stosu.json. Bez danych uwierzytelniajacych w tym pliku.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
